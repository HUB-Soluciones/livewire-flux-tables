{
    "name": "hubsoluciones/livewire-flux-tables",
    "description": "Reusable Livewire-first tables for Laravel with Flux UI styling.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hub Soluciones"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.5.19|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "orchestra/workbench": "^9.15",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "HubSoluciones\\LivewireFluxTables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HubSoluciones\\LivewireFluxTables\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HubSoluciones\\LivewireFluxTables\\LivewireFluxTablesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}